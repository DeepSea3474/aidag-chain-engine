[Unit]
Description=AIDAG-Chain mainnet node (lsc-node, RPC :8645)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/aidag-lsc
Environment=LSC_MAINNET=1
Environment=LSC_PRODUCTION=1
Environment=LSC_RPC_ADDR=0.0.0.0:8645
ExecStart=/root/aidag-lsc/target/release/lsc-node /ip4/0.0.0.0/tcp/40001 /root/aidag-lsc/aidag-mainnet-40001.log
Restart=always
RestartSec=3
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
