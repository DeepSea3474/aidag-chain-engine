#!/usr/bin/env python3
"""
AIDAG belgelerini KUBRA'nın bilgi deposuna (RAG, /kb/ingest) yukler.
Sadece KULLANICIYA ACIK belgeler -- ACIL-DURUM.md, HAZINE_YONETIM.md,
KALKAN_*.md gibi ic/hassas belgeler BILEREK burada YOK.

Buyuk dosyalari ## basliklarina gore parcalara boler (embedding kalitesi
icin -- koca bir dosyayi tek parca olarak gommek retrieval'i bulaniklastirir).

Kurulum gerekmez (sadece Python standart kutuphanesi).

Kullanim:
  python3 kb_yukle.py
"""
import json
import re
import urllib.request

KB_URL = "http://127.0.0.1:8646/kb/ingest"

DOSYALAR = [
    "/root/aidag-lsc/ON_SATIS_PLANI.md",
    "/root/aidag-lsc/TOKENOMICS_TASARIM.md",
    "/root/aidag-lsc/GENESIS_DAGITIM.md",
    "/root/aidag-lsc/YOL_HARITASI.md",
    "/root/aidag-lsc/EKOSISTEM_VIZYONU.md",
]

MAX_CHUNK = 3000


def bolumle(dosya_adi, metin):
    parcalar = re.split(r'^(##\s+.+)$', metin, flags=re.MULTILINE)
    if len(parcalar) <= 1:
        for i in range(0, len(metin), MAX_CHUNK):
            yield (dosya_adi, metin[i:i + MAX_CHUNK])
        return

    if parcalar[0].strip():
        yield (dosya_adi, parcalar[0].strip())
    for i in range(1, len(parcalar), 2):
        baslik = parcalar[i].strip('# ').strip()
        icerik = parcalar[i + 1] if i + 1 < len(parcalar) else ""
        tam = f"{baslik}\n{icerik}".strip()
        if len(tam) > MAX_CHUNK:
            for j in range(0, len(tam), MAX_CHUNK):
                yield (f"{dosya_adi} - {baslik}", tam[j:j + MAX_CHUNK])
        else:
            yield (f"{dosya_adi} - {baslik}", tam)


def ingest(baslik, metin):
    body = json.dumps({"baslik": baslik, "metin": metin}).encode("utf-8")
    req = urllib.request.Request(
        KB_URL, data=body, headers={"Content-Type": "application/json"}, method="POST"
    )
    with urllib.request.urlopen(req, timeout=30) as resp:
        return json.loads(resp.read().decode("utf-8"))


def main():
    toplam = 0
    for yol in DOSYALAR:
        try:
            with open(yol, "r", encoding="utf-8") as f:
                metin = f.read()
        except FileNotFoundError:
            print(f"  ATLA (bulunamadi): {yol}")
            continue
        dosya_adi = yol.rsplit("/", 1)[-1]
        n = 0
        for baslik, parca in bolumle(dosya_adi, metin):

            if len(parca.strip()) < 30:
                continue
            try:
                sonuc = ingest(baslik, parca)
                if sonuc.get("ok"):
                    n += 1
                    toplam += 1
                else:
                    print(f"    HATA ({baslik}): {sonuc}")
            except Exception as e:
                print(f"    HATA ({baslik}): {e}")
        print(f"  {dosya_adi}: {n} parca eklendi")
    print(f"\nToplam eklenen parca: {toplam}")
    print("Kontrol icin: curl -s http://127.0.0.1:8646/kb/stats")


if __name__ == "__main__":
    main()


