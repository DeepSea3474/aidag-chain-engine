--- /etc/nginx/sites-available/aidag-chain	2026-09-23 20:56:51.825383197 +0200
+++ /etc/nginx/sites-available/aidag-chain	2026-09-23 23:31:46.824780965 +0200
@@ -8,6 +8,14 @@
         default_type text/html;
     }
 
+    # Belge dogrulama baglantisi (QR hedefi): /belge/<64 hex> -> ayni sayfa;
+    # sayfa ozeti adresten okuyup zincirde dogrular. Yalniz tam 64-hex yol eslesir.
+    location ~ "^/belge/[0-9a-fA-F]{64}/?$" {
+        root /var/www/aidag;
+        try_files /belge-dogrulama.html =404;
+        default_type text/html;
+    }
+
     # KUBRA sohbet sayfasi
     location = /ask {
         alias /var/www/aidag/ask.html;
